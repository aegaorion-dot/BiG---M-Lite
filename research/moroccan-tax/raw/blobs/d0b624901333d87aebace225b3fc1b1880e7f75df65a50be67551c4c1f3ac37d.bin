                                                <div class="form-control-input">
                                                     <input name="ctl00$ctrlHeader$txtTrnNumberVerify" type="text" maxlength="15" id="ctrlHeader_txtTrnNumberVerify" placeholder="TRN*" aria-describedby="ctrlHeader_reqTrnNumber" />
                                                     
                                                </div>
                                            </div>
                                            
                       
                                        </div>
                                        <div class="col-md-3">
                                            <a onclick="javascript: return doValidationVerifyTRN(&#39;verifyTRN&#39;);" id="ctrlHeader_lnkbTRNSubmit" class="aegov-btn" href="javascript:WebForm_DoPostBackWithOptions(new WebForm_PostBackOptions(&quot;ctl00$ctrlHeader$lnkbTRNSubmit&quot;, &quot;&quot;, true, &quot;verifyTRN&quot;, &quot;&quot;, false, true))">Submit</a>
                                         </div>
                                    
                                    <div class="row">
                                        <div class="form-group captchamargin captcha">
                    
                                                 <div id="ctl00_ctrlHeader_radCaptchaTRN" class="RadCaptcha RadCaptcha_Default">
		<div id="ctl00_ctrlHeader_radCaptchaTRN_SpamProtectorPanel">
			<img id="ctl00_ctrlHeader_radCaptchaTRN_CaptchaImage" class="captchaimageClass" alt="" src="../../../Telerik.Web.UI.WebResource.axd?type=rca&amp;isc=true&amp;guid=446b0c2a-9a7e-46b9-b2be-b4356ce89ff8" height="50" width="180" style="display:block;" /><p><input name="ctl00$ctrlHeader$radCaptchaTRN$CaptchaTextBox" type="text" maxlength="5" id="ctl00_ctrlHeader_radCaptchaTRN_CaptchaTextBox" class="form-control" /><label for="ctl00_ctrlHeader_radCaptchaTRN_CaptchaTextBox" id="ctl00_ctrlHeader_radCaptchaTRN_CaptchaTextBoxLabel">Enter the code as shown in the Image</label></p>
		</div><input id="ctl00_ctrlHeader_radCaptchaTRN_ClientState" name="ctl00_ctrlHeader_radCaptchaTRN_ClientState" type="hidden" />
	</div>
                       
               
                                        </div>
                                    </div>
                               
                                </div>

                                <div class="row tin-form mb-0 pb-0" style="display:none;">  
                                        <div class="col-md-9">                                         
                                            <div class="aegov-form-control">
                                                
                                                <div class="form-control-input">
                                                     <input name="ctl00$ctrlHeader$txtTinNumberVerify" type="text" maxlength="10" id="ctrlHeader_txtTinNumberVerify" placeholder="TIN*" aria-describedby="ctrlHeader_reqTinNumber" />
                                                     
                                                </div>
                                            </div>
                                            
                       
                                        </div>
                                        <div class="col-md-3">
                                            <a onclick="javascript: return doValidationVerifyTIN(&#39;verifyTIN&#39;);" id="ctrlHeader_lnkbTINSubmit" class="aegov-btn" href="javascript:WebForm_DoPostBackWithOptions(new WebForm_PostBackOptions(&quot;ctl00$ctrlHeader$lnkbTINSubmit&quot;, &quot;&quot;, true, &quot;verifyTIN&quot;, &quot;&quot;, false, true))">Submit</a>
                                         </div>  
                                    
                                     <div class="row">
                                         <div class="form-group captchamargin captcha">
                    
                                                <div id="ctl00_ctrlHeader_radCaptchaTIN" class="RadCaptcha RadCaptcha_Default">
		<div id="ctl00_ctrlHeader_radCaptchaTIN_SpamProtectorPanel">
			<img id="ctl00_ctrlHeader_radCaptchaTIN_CaptchaImage" class="captchaimageClass" alt="" src="../../../Telerik.Web.UI.WebResource.axd?type=rca&amp;isc=true&amp;guid=1f98f5cc-d280-47d3-aacf-c0cb6b1e5495" height="50" width="180" style="display:block;" /><p><input name="ctl00$ctrlHeader$radCaptchaTIN$CaptchaTextBox" type="text" maxlength="5" id="ctl00_ctrlHeader_radCaptchaTIN_CaptchaTextBox" class="form-control" /><label for="ctl00_ctrlHeader_radCaptchaTIN_CaptchaTextBox" id="ctl00_ctrlHeader_radCaptchaTIN_CaptchaTextBoxLabel">Enter the code as shown in the Image</label></p>
		</div><input id="ctl00_ctrlHeader_radCaptchaTIN_ClientState" name="ctl00_ctrlHeader_radCaptchaTIN_ClientState" type="hidden" />
	</div>
                       
               
                                         </div>
                                    </div>       
                               
                                </div>
                               
                               

