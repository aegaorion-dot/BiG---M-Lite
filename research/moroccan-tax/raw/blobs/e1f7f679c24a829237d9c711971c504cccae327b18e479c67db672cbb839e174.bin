<article data-history-node-id="118835" role="article" about="/id/peraturan/penentuan-subjek-pajak-dalam-negeri-dan-subjek-pajak-luar-negeri-0" class="node node--type-peraturan node--promoted node--view-mode-full">

  
    

  
  <div class="node__content">
    
            <div class="field field--name-field-jenis-dokumen field--type-entity-reference field--label-hidden field__item">Peraturan Dirjen Pajak</div>
      
            <div class="field field--name-field-nomor-dokumen field--type-string field--label-hidden field__item">PER-23/PJ/2025</div>
      
  <div class="field field--name-field-tanggal-peraturan field--type-datetime field--label-inline clearfix">
    <div class="field__label">Tanggal Peraturan</div>
              <div class="field__item"><time datetime="2025-12-09T12:00:00Z" class="datetime">09-12-2025</time>
</div>
          </div>

            <div class="clearfix text-formatted field field--name-field-body-dalam-html field--type-text-long field--label-hidden field__item"><table border="0" cellpadding="1" cellspacing="1" style="width: &#10;&#10;100%"><tbody><tr><td colspan="2" style="text-align: &#10;&#10;center;">
				 </td>
		</tr><tr><td colspan="2" style="text-align: &#10;&#10;center;">
				<div>
					KEMENTERIAN KEUANGAN REPUBLIK INDONESIA</div>
				<div>
					 </div>
				<div>
					<div>
						PERATURAN DIREKTUR JENDERAL PAJAK</div>
					<div>
						NOMOR PER-23/PJ/2025</div>
					<div>
						 </div>
