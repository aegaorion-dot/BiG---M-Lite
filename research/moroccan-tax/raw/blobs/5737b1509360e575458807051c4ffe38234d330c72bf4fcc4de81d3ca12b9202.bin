  <div class="row no-gutters">
                <div id="ctrlContentArea_GenericContent201352112424_divTitle" class="col-md-8 pageTitle"><h1 class="text-h3">Basis of Taxation - Natural Person</h1></div>
                <div class="col-md-4 text-right">                     
                    <div class=rating>
                     
                    </div> 
                   
                </div>
            </div>

  <div class="row">

     

      <!-- Content Area -->
                <div id="ctrlContentArea_GenericContent201352112424_divContentArea" class="col-md-12">
                    
                    <div class="contentAreaFull allowfontresizer">
                        
                        <div class="finalContent"><span style="font-size: 18px;">A Natural Person is subject to Corporate Tax only if:&nbsp;<br />
</span>
<div>&nbsp;</div>
<ul>
    <li>They Conduct Business or Business Activity in the UAE; and</li>
    <li>Total Turnover derived from Business or Business Activities exceeds AED 1 million within the calendar year (Jan to Dec)</li>
</ul>
<p>&nbsp;</p>
<div><span style="font-size: 18px;">Sources generating the following income streams are not considered as Business or Business Activities:</span></div>
<ul>
    <li>Wages&nbsp;&nbsp;</li>
    <li>Personal Investment Income&nbsp;</li>
    <li>Real Estate Investment Income</li>
</ul>
<p>&nbsp;</p>
<div>&nbsp;</div>
<p><span style="background-color: #4f81bd; font-size: 18px; color: #ffffff;">Natural Persons should not register if:&nbsp;</span></p>
<ul>
    <li><span style="background-color: #4f81bd; color: #ffffff;"><span style="background-color: #4f81bd; font-size: 18px;"></span>they do not conduct a Business or Business Activity in the UAE; or<br />
    </span></li>
    <li><span style="background-color: #4f81bd; color: #ffffff;">conduct a Business or Business Activity generating a turnover not exceeding AED 1 million</span></li>
</ul>
<div>&nbsp;</div> </div>
                        
                    </div>
                    
                     

                    

                    
                    

                    

                    


                </div>
                <!-- Content Area -->


  </div>
 




                
             </div>
         </div>




            

				</div>
