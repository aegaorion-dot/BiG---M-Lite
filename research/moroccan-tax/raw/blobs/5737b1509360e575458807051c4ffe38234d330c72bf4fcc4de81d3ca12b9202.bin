                                         <label for="ctrlHeader_txtYourEmailAddress">
                                             Your email address
                                                <i class="text-danger">*</i>
                                         </label>
                                        <div class="form-control-input">
                                           <input name="ctl00$ctrlHeader$txtYourEmailAddress" type="text" maxlength="80" id="ctrlHeader_txtYourEmailAddress" onkeypress="return(CheckEmailLang(this,event))" onkeydown="(CheckEmailLang(this,event))" placeholder="Enter your email address" autocomplete="email" /> 
                                        </div>
                                        <p class="error-message">
                                            
                                            
                                        </p>
                                    </div>
               
			                    </fieldset>
                                    </div>
                                    <div class="dialog_form_item">
			                             <fieldset>
                                            <div class="aegov-form-control control-secondary control-sm">
                                                <label for="ctrlHeader_txtFriendName">
                                                    Friend name
                                                       <i class="text-danger">*</i>
                                                </label>
                                                <div class="form-control-input">
                                                   <input name="ctl00$ctrlHeader$txtFriendName" type="text" maxlength="60" id="ctrlHeader_txtFriendName" placeholder="Enter friend name" />
                                                </div>
                                                <p class="error-message">
                                                    
                                                </p>
                                            </div>
				
               
			                            </fieldset>
                                    </div>
                                    <div class="dialog_form_item">
			                            <fieldset>	
                                            <div class="aegov-form-control control-secondary control-sm">
                                                 <label for="ctrlHeader_txtFriendEmailAddress">
                                                     Friend email
                                                        <i class="text-danger">*</i>
                                                 </label>
                                                <div class="form-control-input">
                                                   <input name="ctl00$ctrlHeader$txtFriendEmailAddress" type="text" maxlength="80" id="ctrlHeader_txtFriendEmailAddress" onkeypress="return(CheckEmailLang(this,event))" onkeydown="(CheckEmailLang(this,event))" placeholder="Enter friend email address" />
                                                </div>
                                                <p class="error-message">
                                                    
                                                    
                                                </p>
                                            </div>
				
               
			                            </fieldset>
                                 </div>
                                <div class="dialog_form_actions">
			                        <fieldset class="ButtonContainer">
				                        <button id="btnClose_sendtofriend" type="button" class="aegov-btn btn-soft" OnClick="closeDialog(this);resetSendtoFriend();" aria-label="Close">Close</button>
                                        
                                        <a onclick="javascript:return frm_validUserEmail();" id="ctrlHeader_lnkbSendEmail" class="aegov-btn" href="javascript:__doPostBack(&#39;ctl00$ctrlHeader$lnkbSendEmail&#39;,&#39;&#39;)">Send</a>
			                        </fieldset>
                                </div>
                                <script language="javascript" type="text/javascript">

                                    function frm_validUserEmail() {

                                        var isValidForm = true;
                                        if (!Page_ClientValidate("SendEmail")) {
                                            isValidForm = false;
                                        }

                                        return isValidForm;

                                    }


                                </script>
                                
	</div>
		                    
</div>
