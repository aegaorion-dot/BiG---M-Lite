    function sideFloatingCustomerPulseLoader() {
        var lang = 'en';
        if (document.location.href.toLowerCase().indexOf('/ar/') > -1) {
            lang = 'ar';
        }

        window.CustomerPulse.render(
            document.getElementById('ftaBody2'),
            {
                modal: true,
                link: 'v2/E/kV',
                lang: lang
            },
        );

        window.CustomerPulse.openModal();
    }


    //TRN,VAT,status check
    function toggleTRN() {
        $("#option_01_trn").prop("checked", true);
        $("#option_02_tin").prop("checked", false);
        $(".trn-form").show();
        $(".tin-form").hide();


        $("#ctrlHeader_txtTrnNumberVerify").val('');
        $("#ctrlHeader_txtTinNumberVerify").val('');

        //$(".vat-wrapper").addClass('disable-wrapper');
        $('#modal-trn').toggleClass('hidden', 1000);

        //Set foucs on popup first element
        $("#ctrlHeader_txtTrnNumberVerify").focus();
        
    }

    function toggleVAT() {
         
        $("#txtAmount").val('');
        $("#txtAmountAfter").val('');
        $("#txtTaxAmount").val('');

        //$(".trn-wrapper").addClass('disable-wrapper');
        $('#modal-vat').toggleClass('hidden', 1000);

        //Set foucs on popup first element
        $("#txtAmount").focus();
    }
    function doValidationVerifyTRN(valgroup) {

        var flag = true;
        flag = validateFormGroup(valgroup);
        if (flag) {
            flag = $("#ctrlHeader_txtTrnNumberVerify").val().length == 15;
            $("#ctrlHeader_txtTrnNumberVerify").css("border-color", flag ? "#ccc" : "red");
            $("#ctrlHeader_reqTrnNumber").css("display", flag ? "none" : "block");

            if (!flag) {
                $("#ctrlHeader_txtTrnNumberVerify").focus();
            }
        }
        else {
            $("#ctrlHeader_txtTrnNumberVerify").focus();
        }
         return flag; //  flag;
    }

    function showResult() {
        //var msg = message;
        $("#lnkTRNVerifyResults").click();
        //$.fancybox({ content: '<div class="RedirectBox"><i class="ph ph-check-circle oksign"> </i> ' + msg + ' <div class="RedirectActions"><a class="btn-u" href="javascript:closeFancybox();">Ok</a> </div></div>' });
    }
    function CloseUAEPassLoginOnlyInfo() {
        $(".uaepassLoginOnly").hide();
        $("body").removeClass("withlogininfo");
    }

    function setTopUAEPassLoginOnlyInfo() {
        if ($("#ctrlHeader_topInfoBar").hasClass("uaepassLoginOnly")) {
            $("body").addClass("withlogininfo");
        }
        else {
            $("body").removeClass("withlogininfo");
        }
    }
    function toggleRateTRN() {
        $.fancybox.close();
         $('#lnkRateTRNResults').click();
    }
   function toggleResultsTRN() {
        $.fancybox.close();
    }
    function closeRateTRN() {
         $.fancybox.close();
     }
    function resetVAT() {
        $("#txtAmount").val('');
        $("#txtAmountAfter").val('');
        $("#txtTaxAmount").val('');
    }
    function resetTRN() {
         $("#option_01_trn").prop("checked", true);
         $("#option_02_tin").prop("checked", false);
         $(".trn-form").show();
         $(".tin-form").hide();


         $("#ctrlHeader_txtTrnNumberVerify").val('');
         $("#ctrlHeader_txtTinNumberVerify").val('');

        
        var flag = true;
        $("#ctrlHeader_reqTrnNumber").css("display", flag ? "none" : "block");
        $("#ctrlHeader_reqTinNumber").css("display", flag ? "none" : "block");

        $("#ctrlHeader_hdnSelectedTRNTINOption").val("TRN");
         console.log("tin - reset - 1");
    }
    function resetSendtoFriend() {
        $("#ctrlHeader_txtYourName").val('');
        $("#ctrlHeader_txtYourEmailAddress").val('');
        $("#ctrlHeader_txtFriendName").val('');
        $("#ctrlHeader_txtFriendEmailAddress").val('');

        var flag = true;
        $("#ctrlHeader_reqYourName").css("display", flag ? "none" : "block");
        $("#ctrlHeader_reqYourEmailAddress").css("display", flag ? "none" : "block");
        $("#ctrlHeader_regExYourEmailAddress").css("display", flag ? "none" : "block");
        $("#ctrlHeader_reqFriendName").css("display", flag ? "none" : "block");
        $("#ctrlHeader_reqFriendEmailAddress").css("display", flag ? "none" : "block");
        $("#ctrlHeader_regExFriendEmailAddress").css("display", flag ? "none" : "block");

         
    }
    function OpenAccessibility() {
        $('#MrAccessInHand').click();
    }
    function autoCompleteOnSearchComplete(query, suggestions) {
        //console.log('Search finished for: ' + query);
        //console.log('Number of suggestions found: ' + suggestions.length);
        
       
        if (suggestions.length > 0) {
            //console.log('First suggestion: ' + suggestions[0].value);
            $("#divAutocompleteSearchStatus").html(suggestions.length + " result(s) found");
        }
        else {
            $("#divAutocompleteSearchStatus").html("No result(s) found");
        }
    }


     function doValidationVerifyTIN(valgroup) {

         var flag = true;
         flag = validateFormGroup(valgroup);    
         if (flag) {
             flag = $("#ctrlHeader_txtTinNumberVerify").val().length == 10;
             $("#ctrlHeader_txtTinNumberVerify").css("border-color", flag ? "#ccc" : "red");
             $("#ctrlHeader_reqTinNumber").css("display", flag ? "none" : "block");

             if (!flag) {
                 $("#ctrlHeader_txtTinNumberVerify").focus();
             }
         }
         else {
             $("#ctrlHeader_txtTinNumberVerify").focus();
         }
         //console.log('tin -- 02');

          return flag; //  flag;
    }

    function ToggleTRNForm(obj) {
        $(".trn-form").show();
        $(".tin-form").hide();
        $("#ctrlHeader_hdnSelectedTRNTINOption").val("TRN");
    }
    function ToggleTINForm(obj) {
        $(".trn-form").hide();
        $(".tin-form").show();
         $("#ctrlHeader_hdnSelectedTRNTINOption").val("TIN");
    }

    function pageLoad(sender, args) {
        if (args.get_isPartialLoad()) {

            //console.log('parial load -- 00');
            //console.log('Seleced OPion' + $("#ctrlHeader_hdnSelectedTRNTINOption").val());
            if ($("#ctrlHeader_hdnSelectedTRNTINOption").val() == "TIN") {
                $("#option_01_trn").prop("checked", false);
                $("#option_02_tin").prop("checked", true);
                $(".trn-form").hide();
                $(".tin-form").show();
            }
            else {
                 $("#option_01_trn").prop("checked", true);
                 $("#option_02_tin").prop("checked", false);
                 $(".trn-form").show();
                 $(".tin-form").hide();
            }

             
        }
    }

    
</script>

        

<section >
    <div class="container mt-3">

           <section class="importantInfo !mt-0">
            <div class="flex items-center"><i class="ph ph-info"></i> <span class="caption">Latest News</span></div>
   
    <div class="infoScroll1">
            <div class="slick-slider-newsscroll">
            
<div class="slick-slide"><a id="ctlNewsTicker_rptLatestNews_lnkTitle_0" title="Federal Tax Authority highlights experience in expanding smart tax systems at Belt and Road Initiative Tax Administration Cooperation Forum" href="https://tax.gov.ae/en/media.centre/news/federal.tax.authority.highlights.experience.in.expanding.smart.tax.systems.at.belt.and.road.initiative.tax.administration.cooperation.forum.aspx">Federal Tax Authority highlights experience in expanding smart tax systems at Belt and Road Initiative Tax Administration Cooperation Forum</a></div>

