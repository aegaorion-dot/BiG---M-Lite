}
.btn-right-sidebar:hover{
    text-decoration: none;
    color: #000;
    background-color: #e8be30;
}
.content-page{
  box-shadow: 0 2px 4px 0 rgba(0,0,0,.2), 0 3px 10px 0 rgba(0,0,0,.19);
