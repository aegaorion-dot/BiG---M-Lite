				<div style="text-align: justify;">
					 </div>
			</td>
			<td style="vertical-align: top;">
				<div style="text-align: justify;">
					 </div>
			</td>
			<td style="vertical-align: top;">
				<div style="text-align: justify;">
					2.</div>
			</td>
			<td colspan="10" rowspan="1" style="vertical-align: top;">
				<div style="text-align: justify;">
					cadangan untuk usaha asuransi termasuk cadangan bantuan sosial yang dibentuk oleh Badan Penyelenggara Jaminan Sosial;</div>
			</td>
