				<div style="text-align: center;">
					<strong>Pasal 11</strong></div>
			</td>
		</tr><tr><td style="vertical-align:top">
				<div>
					 </div>
			</td>
			<td style="vertical-align:top">
				<div>
					 </div>
			</td>
			<td style="vertical-align:top">
				<div style="text-align: justify;">
					(1)</div>
			</td>
			<td colspan="13" rowspan="1" style="vertical-align: top;">
				<div style="text-align: justify;">
					Terhadap Wajib Pajak orang pribadi yang telah memperoleh surat keterangan sebagaimana dimaksud dalam Pasal 10 ayat (6), berlaku ketentuan:</div>
			</td>
		</tr><tr><td style="vertical-align:top">
				<div>
					 </div>
			</td>
