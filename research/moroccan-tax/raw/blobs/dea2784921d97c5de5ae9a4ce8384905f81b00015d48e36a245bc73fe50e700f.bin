<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="Content-Language" content="fr" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta http-equiv="cache-control" content="no-cache, no-store, must-revalidate" />
  <meta http-equiv="pragma" content="no-cache" />
  <meta http-equiv="expires" content="0" />
  
  <title>Session bloqu&eacute;e</title>

  <style>
    :root { color-scheme: light; }
    body {
      margin: 0;
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      color: #2a2d30;
      background: #fff;
    }
    .container {
      max-width: 800px;
      margin: 10px auto;
      padding: 0 16px;
      color: #7a838c;
      text-align: center;
    }

    /* Style du texte "Session bloquee" */
    h1 {
      color: #2a2d30;
      font-weight: bold;
      font-size: 40px;
      margin-top: 5px;
    }

    /* Mise en page pour aligner le texte ÃÂ  gauche */
    #interstitial-body {
      background: #f8f9fa;
      border: 1px solid #e9ecef;
      border-radius: 8px;
      padding: 16px;
      text-align: left;
    }

    h2 {
      color: #2a2d30;
      font-size: 22px;
      margin-bottom: 10px;
    }

    p, ul {
      color: #2a2d30;
      font-size: 18px;
      line-height: 1.6;
    }

    ul { padding-left: 20px; }
    li { margin: 0 0 10px; }
    a { color: #428bca; text-decoration: none; }
    a:hover, a:focus { color: #2a6496; text-decoration: underline; }

    .footer {
      margin-top: 16px;
      font-size: 14px;
      color: #555;
      text-align: left;
    }
    .footer b { color: #2a2d30; }

    /* Logo optionnel */
    .brand {
      text-align: center;
      margin-bottom: 20px;
    }
    .brand img {
      height: 180px;
      width: auto;
    }

    /* Styles pour le texte final et date */
    .body-end-bold {
      font-weight: normal !important;
      font-size: 18px !important;
      color: #000 !important;
      text-align: left !important;
      margin-left: 2px !important;
      padding-left: 0 !important;
    }

    .incident-date {
      font-size: 18px !important;
      text-align: left !important;
      margin-top: 8px !important;
      margin-left: 5px !important;
      color: #000 !important;
      font-style: normal !important;
      font-weight: normal !important;
      text-decoration: underline;
      margin-top: -2px;
    }
  </style>

  <script>
    function showBlockPage() {
      document.title = "SESSION BLOQUEE";
      var elems = document.getElementsByClassName("interruption-message");
      for (var i = 0; i < elems.length; ++i) {
        elems[i].style.display = "block";
      }
    }
    setTimeout(showBlockPage, 10000);
  </script>

  
                    <script>
                    var element = document.createElement('script');
                    var url = 'https://js.hcaptcha.com/1/api.js';
                    if (window.hcaptchaLang) {
                        url += '?hl=' + window.hcaptchaLang;
                    }
                    element.setAttribute('src', url);
                    document.head.appendChild(element);
                </script>
                    <script>
                        function solvedCaptcha(payload) {
                            const timeoutMs = 10000;
                            protectionSubmitCaptcha("hcaptcha", payload, timeoutMs, "3:IULl9ZSOpWehmSsjLboKzA==:OxOO0TT7weYU5gEtNNL80MAxarRFI9TfCqHFNwabk8thT2RuSYVjZjlAqxx0jIgAXlG6yJ2EVKz88JhohbxlJsHBD3o2RZ318MumP+zhrtO9bSZLKR+M6idH3A4bMGsRg0venE2WfuoXCWOhtuAkN4Ho5dDpBNy0nyuBIMzS0dMwpshVvjDuZLZxJA/DLYmq:gtklKtrP0UFXfrZKsNCY9/u45wipnshVLuTbaJJqTHU=")
                                .then(
                                    function() {
                                        window.location.reload(true);
                                    },
                                    function(error) {
                                        console.log(error);
                                    },
                                );
                        }
                    </script>
                
  <script src="/abp" async defer></script>
</head>

<body>
  

  <!-- Message visible si JavaScript est dÃÂ©sactivÃÂ© -->
  <noscript>
    <div class="container">
      <h1>Session bloqu&eacute;e</h1>
      <p>Vous avez d&eacute;sactiv&eacute; JavaScript dans votre navigateur web. Veuillez l'activer et recharger cette page pour continuer.</p>
    </div>
  </noscript>

  <div class="container interruption-message">
    <!-- Logo -->
    <div class="brand">
      <img src="data:image/png;base64," alt="Logo DGI">
      <h1>Votre session a &eacute;t&eacute; bloqu&eacute;e</h1>
    </div>

    <div id="interstitial-body">
      <h2>Le comportement de votre navigateur ou de votre r&eacute;seau nous fait penser que vous &ecirc;tes un robot.</h2>
      <p>Nous avons bloqu&eacute; votre session. Que faire pour r&eacute;soudre ce probl&egrave;me ?</p>
      <ul>
        <li>R&eacute;ssayez de vous connecter &agrave; partir d'un autre navigateur ou d'un autre poste.</li>
        <li>Assurez-vous d'avoir activ&eacute; JavaScript dans votre navigateur web.</li>
        <li>Supprimez tous les plugins de navigateurs tiers qui peuvent &ecirc;tre en cours d'ex&eacute;cution.</li>
      </ul>
      <p id="identify-msg" style="display:none">Pour retrouver l'acc&eacute;s, assurez-vous que les cookies et JavaScript sont activ&eacute;s, puis rechargez la page.</p>
      <p id="captcha-msg" style="display:none">Pour retrouver l'acc&eacute;s, assurez-vous que les cookies et JavaScript sont activ&eacute;s et compl&eacute;tez le CAPTCHA ci-dessous.</p>
    </div>

     <div class="body-end-bold" style="text-align: left; font-size: 18px !important;">
        <style>
            .body-end-bold, 
            .body-end-bold * {
              font-size: 18px !important;
              text-align: left !important;
              color: #000 !important;
              margin-left: 2px !important;
              padding-left: 0 !important;
              font-weight: normal !important;
              margin-top: 0px;
            }
         </style>

         
                    <script>
                    showBlockPage()
                    var e = document.getElementById("captcha-msg");
                    if (e) {
                        e.style.display = "";
                    }
                    </script>
                <div class="h-captcha" data-sitekey="4a23e8c5-05f9-459a-83ca-4a4041cf6bea" data-callback="solvedCaptcha"></div>

         <!-- Date affichÃÂ©e sous 
                    <script>
                    showBlockPage()
                    var e = document.getElementById("captcha-msg");
                    if (e) {
                        e.style.display = "";
                    }
                    </script>
                <div class="h-captcha" data-sitekey="4a23e8c5-05f9-459a-83ca-4a4041cf6bea" data-callback="solvedCaptcha"></div> -->
         <div class="incident-date" id="incident-date"></div>
    </div>

    <div class="footer">
      <p>Si vous pensez qu'il s'agit d'une erreur, veuillez contacter notre centre d'appel via t&eacute;l&eacute;phone au <b>0537273727</b> ou en envoyant un email &agrave; l'adresse
      <b>simpl@tax.gov.ma</b>.</p>
    </div>
  </div>

  <script>
    // Masquer la section quand JS fonctionne (elle sera affichÃÂ©e par setTimeout si JS ne se termine pas)
    (function(){
      var elems = document.getElementsByClassName("interruption-message");
      for (var i = 0; i < elems.length; ++i) {
        elems[i].style.display = "none";
      }
    })();

    // GÃÂ©nÃÂ©rer la date au format JJ/MM/AAAA HH:MM:SS
    function formatDate(date) {
      const pad = n => (n < 10 ? '0' + n : n);
      return `${pad(date.getDate())}/${pad(date.getMonth()+1)}/${date.getFullYear()} ${pad(date.getHours())}:${pad(date.getMinutes())}:${pad(date.getSeconds())}`;
    }
    document.getElementById("incident-date").textContent = "Date de l'incident : " + formatDate(new Date());
  </script>
</body>
</html>


