				<td style="width: 23px;">
					 </td>
				<td style="width: 24px; text-align: left; vertical-align: top;">
					 </td>
				<td style="width: 22px; text-align: left; vertical-align: top;">
					2)</td>
				<td colspan="2" style="width: 510px; text-align: justify;">
					Pembukuan 1 April 1985 s/d 31 Maret 1986. </td>
			</tr><tr><td style="width: 20px;">
					 </td>
				<td style="width: 23px;">
					 </td>
				<td style="width: 24px; text-align: left; vertical-align: top;">
					 </td>
				<td style="width: 22px; text-align: left; vertical-align: top;">
					 </td>
				<td colspan="2" style="width: 510px; text-align: justify;">
					Tahun pajak ialah tahun 1985, karena tahun 1985 mempunyai lebih dari enam bulan dari tahun pajak itu.</td>
			</tr><tr><td style="width: 20px;">
					 </td>
				<td style="width: 23px;">
