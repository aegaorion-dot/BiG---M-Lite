le-trader","content_id":"01ff8dbd-886a-4dbb-872c-d2092b31b2cf","details":{"step_by_step_nav":{"steps":[{"contents":[{"contents":[{"href":"/become-sole-trader","text":"Find out more about becoming a sole trader"}],"type":"list"}],"title":"Check if being a sole trader is right for you"},{"contents":[{"contents":[{"href":"/become-sole-trader/choose-your-business-name","text":"Check the rules for naming your business"}],"type":"list"}],"title":"Choose your business name"},{"contents":[{"text":"When you start trading you must keep records. This will help you work out your profit or loss for your tax return.","type":"paragraph"},{"contents":[{"href":"/self-employed-records","text":"Find out what business records you need to keep"}],"type":"list"}],"title":"Check what records you need to keep"},{"contents":[{"contents":[{"href":"/become-sole-trader/register-sole-trader","text":"Check how to register as a sole trader"}],"type":"list"}],"title":"Register as a sole trader"},{"contents":[{"text":"There may be other taxes and rules you need to know about after you’ve registered as a sole trader.","type":"paragraph"},{"contents":[{"href":"/guidance/check-what-taxes-may-apply-to-you-as-a-sole-trader","text":"Check what taxes may apply to you as a sole trader"}],"type":"list"}],"title":"Check what taxes may apply to you"},{"contents":[{"text":"You may need to pay Income Tax on your profits and may need to pay National Insurance contributions.","type":"paragraph"},{"contents":[{"href":"/self-assessment-tax-calculator","text":"Get an estimate of how much you will need to pay"}],"type":"list"},{"contents":[{"href":"/income-tax-rates","text":"Find out more about Income Tax rates"}],"type":"list"},{"contents":[{"href":"/self-employed-national-insurance-rates","text":"Find out more about National Insurance rates"}],"type":"list"}],"title":"Plan for your tax bill "},{"contents":[{"contents":[{"href":"https://subscriptions.hmrc.gov.uk/","text":"Sign up for business support emails"}],"type":"list"},{"contents":[{"href":"/guidance/help-and-support-if-youre-self-employed","text":"Join a webinar or watch a video to learn more about your responsibilities"}],"type":"list"},{"contents":[{"href":"/guidance/how-to-choose-a-tax-agent","text":"Find out how to choose a tax agent if you want to use one"}],"type":"list"}],"title":"Get help and support"}],"title":"Set up as a sole trader: step by step"}},"document_type":"step_by_step_nav","links":{"pages_part_of_step_nav":[{"api_path":"/api/content/become-sole-trader","api_url":"https://www.gov.uk/api/content/become-sole-trader","base_path":"/become-sole-trader","content_id":"097e75a6-fa8b-455e-8449-f3855f78285b","document_type":"guide","links":{},"locale":"en","public_updated_at":"2015-02-09T16:27:17Z","schema_name":"guide","title":"Become a sole trader","web_url":"https://www.gov.uk/become-sole-trader","withdrawn":false}]},"locale":"en","public_updated_at":"2025-02-27T16:08:46Z","schema_name":"step_by_step_nav","title":"Set up as a sole trader: step by step","web_url":"https://www.gov.uk/set-up-as-sole-trader","withdrawn":false}],"primary_publishing_organisation":[{"analytics_identifier":"OT1056","api_path":"/api/content/government/organisations/government-digital-service","api_url":"https://www.gov.uk/api/content/government/organisations/government-digital-service","base_path":"/government/organisations/government-digital-service","content_id":"af07d5a5-df63-4ddc-9383-6a666845ebe9","details":{"acronym":"GDS","brand":"government-digital-service","default_news_image":null,"logo":{"crest":"gds","formatted_title":"Government<br/>Digital Service"},"organisation_govuk_status":{"status":"live","updated_at":null,"url":null}},"document_type":"organisation","links":{},"locale":"en","schema_name":"organisation","title":"Government Digital Service","web_url":"https://www.gov.uk/government/organisations/government-digital-service","withdrawn":false}],"taxons":[{"api_path":"/api/content/employment/self-employed","api_url":"h