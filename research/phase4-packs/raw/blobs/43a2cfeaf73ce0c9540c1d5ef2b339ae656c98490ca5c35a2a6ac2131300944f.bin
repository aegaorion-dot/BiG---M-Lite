}


a.login-btn{
      border-radius: 0 0 4px 4px;
      font-weight: 700;
      line-height: 20px;
      padding: 10px 15px;
      text-transform: uppercase;
      background: #FFCA19;
      color: black !important;
      margin-left: 20px;
}
a.login-btn:hover{
      text-decoration: none;
      background: #e8be30;
}

html a.scroll-to-top {
    right: unset;
    left: 90px;
}

.tgl-tenggat {
    top: 30px !important;
}

