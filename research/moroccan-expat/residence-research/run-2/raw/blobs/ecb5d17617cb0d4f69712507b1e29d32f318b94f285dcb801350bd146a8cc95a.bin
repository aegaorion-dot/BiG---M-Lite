    <script src="/lib/pdfjs-express-viewer/webviewer.min.js"></script>
    <script>
        var page;
        const bsCollapse = new bootstrap.Collapse('#kt_advanced_search_form', { toggle: false });
        var container = document.getElementById('viewer');
        var pdfViewer = WebViewer({
            path: '/lib/pdfjs-express-viewer/public',
            licenseKey: '9ilKw7sYR73oi7WwlK4v',
            extension: 'pdf',
            disableLogs: true
        }, container)
            .then(instance => {
                const { Core, UI } = instance;
                UI.disableElements(['ribbons', 'contextMenuPopup']);
                UI.setToolbarGroup('toolbarGroup-View');
                UI.setHeaderItems(header => {
                    const items = header.getItems().filter(h => h.dataElement != 'toggleNotesButton');
                    header.update(items);
                });
                UI.setFitMode(UI.FitMode.FitWidth);

                Core.documentViewer.on('documentLoaded', (e) => {
                    if (page) {
                        instance.updateElement('downloadButton', {
                            onClick: () => {
                                UI.downloadPdf({ filename: page.fileName });
                            }
                        });
                    }
                });
            });

        document.addEventListener('alpine:init', () => {
            Alpine.store('page', {
                fileBlob: null,
                fileName: null,
                preview(id, filename, pagenum = 1) {
                    this.fileName = filename;

                    if (pdfViewer) {
                        var fileUrl = `/Download/${id}/${filename}`;
                        fetch(fileUrl).then(function (response) {
                            const { Core, UI } = getInstance();
                            Core.documentViewer.closeDocument();
                            UI.closeElements(['errorModal']);
                            if (response.status === 200) {

                                $("#preview").modal("show");

                                response.blob().then(function (myBlob) {
                                    page.fileBlob = myBlob;
                                    Core.documentViewer.loadDocument(myBlob, { extension: 'pdf' });
                                });

                                Core.documentViewer.on('documentLoaded', (e) => {
                                    UI.setFitMode(UI.FitMode.FitPage);
                                    Core.documentViewer.setCurrentPage(pagenum);
                                });
                            } else {
                                const msg = `Tidak dapat menampilkan file [${filename}] karena tidak tersedia!`;
                                UI.displayErrorMessage(msg);
                            }
                        });
                    }
                }
            });
            page = Alpine.store('page');
        });
    </script>

