# Contoh konfigurasi lokal — JANGAN isi key asli di repo. Copy ke .env (di-ignore git).
BIGM_META_API_URL=
BIGM_META_API_KEY=
BIGM_META_MODEL=
# Endpoint is the complete Responses URL; select a model available to your account.
# BIGM_META_API_URL=https://api.meta.ai/v1/responses
# BIGM_META_MODEL=muse-spark-1.3
# Data defaults to ./data/store.json when starting the web server.
# BIGM_DATA_PATH=
# Legacy document smoke opt-in (the web app uses the shared Muse runtime):
BIGM_META_DOCUMENT_LIVE=0
# One synthetic document-understanding call via npm run smoke:document-meta:
BIGM_META_LIVE_TEST=0
# With all three Meta settings present, the web app uses Muse for semantics.
# Set 0 for offline operation. Routine npm test strips all live configuration.
BIGM_MUSE_ENABLED=1
BIGM_MUSE_MAX_REQUESTS=100
# Optional local developer/demo trace, protected by the existing API token.
BIGM_MUSE_TRACE=0
# Only explicit historical FX quote actions call Frankfurter; rendering is offline.
# Opt-in synthetic one-request FX verification: npm run test:fx:live
BIGM_FX_LIVE_TEST=0
# Isolated demo only (data/demo), 12 Meta requests per process; default is offline.
BIGM_DEMO_LIVE=0
BIGM_DEMO_PORT=3109
# Controlled 5-request synthetic Phase 9 acceptance: BIGM_META_LIVE_TEST=1 npm run test:demo:live
