{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bigm:raw-artifact:1",
  "title": "RawArtifact v1",
  "type": "object",
  "required": ["artifactId", "sourceId", "jurisdictionCode", "authorityCode", "sourceUrl", "finalUrl", "sourceType", "retrievalMethod", "retrievedAt", "httpStatus", "contentType", "language", "officialDocumentId", "title", "publishedAt", "effectiveFrom", "effectiveTo", "rawContentHash", "rawStorageRef", "parserVersion", "byteLength", "status"],
  "properties": {
    "artifactId": {"type": "string", "format": "uuid"},
    "sourceId": {"type": "string"},
    "jurisdictionCode": {"enum": ["ID", "SG", "AU", "US", "GB"]},
    "authorityCode": {"type": "string"},
    "sourceUrl": {"type": "string", "format": "uri"},
    "finalUrl": {"type": "string", "format": "uri"},
    "sourceType": {"enum": ["JSON", "XML", "HTML", "PDF", "ZIP", "INVALID_JSON", "UNSUPPORTED"]},
    "retrievalMethod": {"enum": ["API", "STRUCTURED_DOWNLOAD", "FEED", "HTML", "PDF_TEXT", "PDF_OCR"]},
    "retrievedAt": {"type": "string", "format": "date-time"},
    "httpStatus": {"type": "integer", "minimum": 100, "maximum": 599},
    "contentType": {"type": ["string", "null"]},
    "language": {"type": ["string", "null"]},
    "officialDocumentId": {"type": ["string", "null"]},
    "title": {"type": ["string", "null"]},
    "publishedAt": {"type": ["string", "null"]},
    "effectiveFrom": {"type": ["string", "null"], "format": "date"},
    "effectiveTo": {"type": ["string", "null"], "format": "date"},
    "rawContentHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rawStorageRef": {"type": "string", "pattern": "^blobs/[a-f0-9]{64}\\.bin$"},
    "parserVersion": {"const": "fabric-raw/1"},
    "byteLength": {"type": "integer", "minimum": 0},
    "status": {"enum": ["DISCOVERED", "MIME_MISMATCH", "HTTP_ERROR"]},
    "redirects": {"type": "array"},
    "duplicateContent": {"type": "boolean"},
    "unstableUrl": {"type": "boolean"}
  },
  "additionalProperties": true
}
